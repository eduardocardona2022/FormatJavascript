# Configuración del backend. Copia este archivo a `.env` en la raíz.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Límite de entrada en bytes (1 MiB por defecto).
MAX_SOURCE_BYTES=1048576

# Límite de peticiones por IP.
# En Vercel el límite es por instancia de función, no global.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute

# Tiempo máximo de formateo y número de hilos del pool.
# En Vercel se ignora FORMATTER_MAX_THREADS: Prettier se ejecuta en proceso.
FORMAT_TIMEOUT_MS=5000
FORMATTER_MAX_THREADS=2

LOG_LEVEL=info
# En Vercel se activa automáticamente. Define `false` para desactivarlo.
TRUST_PROXY=false

# Opcional: ruta absoluta o relativa al build del frontend en producción.
# No la definas en Vercel: los estáticos los sirve el CDN.
# WEB_DIST_PATH=apps/web/dist
